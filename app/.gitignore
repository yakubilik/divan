node_modules/
.expo/
dist/
# Anchored: these are the prebuild output at the app root, not every folder
# that happens to be called ios or android — a native module keeps its own.
/ios/
/android/
*.log
# …except the one recording both readings of a run's log are checked
# against, which is a fixture rather than something a run left behind.
!scripts/fixtures/*.log
.DS_Store
identity.local.json
scripts/.material-symbols-rounded.woff2

# EMA models, copied from tts/models by scripts/copy-tts-models.sh
/assets/tts/*.onnx
