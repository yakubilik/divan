{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01XqqFC43F1BgZYvBqKb6gtQ", "type": "tool_result", "content": "1\tconst HOME = /^\\/Users\\/[^/]+|^\\/home\\/[^/]+|^C:\\\\Users\\\\[^\\\\]+/i;\n2\tconst HOME_ANYWHERE = /\\/Users\\/[^/\\s'\"]+|\\/home\\/[^/\\s'\"]+|C:\\\\Users\\\\[^\\\\\\s'\"]+/gi;\n3\t\n4\t/** `/Users/you/projects/some-app` \u2192 `~/projects/some-app`. */\n5\texport function tilde(path: string | null | undefined): string {\n6\t  if (!path) return '';\n7\t  return path.replace(HOME, '~');\n8\t}\n9\t\n10\t/** Same, but for a whole command line, where the path is somewhere in the\n11\t *  middle: a one-line summary has no room for a home directory, and a shared\n12\t *  screen has no reason to carry the account name. Display only. */\n13\texport function tildeAll(text: string | null | undefined): string {\n14\t  if (!text) return '';\n15\t  return text.replace(HOME_ANYWHERE, '~');\n16\t}\n17\t\n18\t/** The last one or two segments, for when a full path will not fit. */\n19\texport function shortPath(path: string | null | undefined, keep = 2): string {\n20\t  const t = tilde(path);\n21\t  const parts = t.split(/[/\\\\]/).filter(Boolean);\n22\t  if (parts.length <= keep) return t;\n23\t  return '\u2026/' + parts.slice(-keep).join('/');\n24\t}\n25\t\n26\texport function cost(v: number | null | undefined): string {\n27\t  const n = Number(v);\n28\t  if (!Number.isFinite(n) || n === 0) return '$0';\n29\t  if (n < 0.01) return `$${n.toFixed(4)}`;\n30\t  return `$${n.toFixed(2)}`;\n31\t}\n32\t\n33\texport function tokens(v: number | null | undefined): string {\n34\t  const n = Number(v);\n35\t  if (!Number.isFinite(n)) return '\u2014';\n36\t  if (n < 1000) return String(n);\n37\t  if (n < 1_000_000) return `${(n / 1000).toFixed(n < 10_000 ? 1 : 0)}k`;\n38\t  return `${(n / 1_000_000).toFixed(1)}M`;\n39\t}\n40\t"}]}, "parent_tool_use_id": null, "session_id": "9f171cbb-c89d-4764-b617-d73dd7c4e2bb", "uuid": "b856e3f9-185c-46f7-b97f-