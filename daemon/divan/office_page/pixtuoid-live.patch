+
+    /// Divan: the desks a `w`×`h`-unit office lays out, in seat order, as JSON
+    /// `[[x, y], …]` in layout units (each desk's top-left), so the host can
+    /// give each group of agents a block of desks of its own.
+    pub fn desks_json(&self, w: u32, h: u32) -> String {
+        let (uw, uh) = self.units(w, h);
+        let desks = pixtuoid_scene::layout::SceneLayout::compute(
+            pixtuoid_scene::layout::Viewport::full(uw, uh),
+            None,
+            self.floor_seed,
+        )
+        .map(|l| l.home_desks)
+        .unwrap_or_default();
+        let parts: Vec<String> = desks.iter().map(|d| format!("[{},{}]", d.at.x, d.at.y)).collect();
+        format!("[{}]", parts.join(","))
+    }
+
+    /// Divan: the decor of a `w`×`h`-unit office, as JSON `[[kind, x, y], …]`
+    /// in layout units — aisle pieces at their centre, wall pieces (`Wall…`,
+    /// the rolling whiteboard among them) at their top-left — so the host can
+    /// hang things on them (a product's logo on the whiteboard).
+    pub fn decor_json(&self, w: u32, h: u32) -> String {
+        let (uw, uh) = self.units(w, h);
+        let items = pixtuoid_scene::layout::SceneLayout::compute(
+            pixtuoid_scene::layout::Viewport::full(uw, uh),
+            None,
+            self.floor_seed,
+        )
+        .map(|l| {
+            // Aisle pieces at their centre; wall pieces (the rolling
+            // whiteboard among them) at their top-left, named `Wall…`.
+            let pod = l.pod_decor.iter().map(|d| format!("[\"{:?}\",{},{}]", d.kind, d.pos.x, d.pos.y));
+            let wall = l.wall_decor.iter().map(|d| format!("[\"Wall{:?}\",{},{}]", d.kind, d.pos.x, d.pos.y));
+            pod.chain(wall).collect::<Vec<String>>()
+        })
+        .unwrap_or_default();
+        let parts = items;
+        format!("[{}]", parts.join(","))
+    }
+
+    /// Divan: seat the agent of `session_id` at desk `index` of the ground
+    /// floor, whoever sat there taking its old desk. False when no live agent
+    /// has that session.
+    pub fn seat(&mut self, session_id: &str, index: u32) -> bool {
+        let target = Some(FloorDesk::new(0, index as usize));
+        let Some(me) = (self.scene.agents.iter())
+            .find(|(_, s)| &*s.session_id == session_id && s.exiting_at.is_none())
+            .map(|(id, _)| *id)
+        else {
+            return false;
+        };
+        let mine = self.scene.agents[&me].desk;
+        if mine == target {
+            return true;
+        }
+        let other = (self.scene.agents.iter())
+            .find(|(id, s)| **id != me && s.desk == target)
+            .map(|(id, _)| *id);
+        if let Some(other) = other {
+            if let Some(slot) = self.scene.agents.get_mut(&other) {
+                slot.desk = mine;
+            }
+        }
+        if let Some(slot) = self.scene.agents.get_mut(&me) {
+            slot.desk = target;
+        }
+        true
+    }
