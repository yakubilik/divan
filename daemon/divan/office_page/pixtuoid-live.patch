+    pub fn live(seed: u32) -> Result<Office, JsError> {
+        // The host writes its own words; the neon wall board would stand empty.
+        pixtuoid_scene::layout::take_board_down();
+        Self::on_screen(seed, page_clock(), Show::Live)
+            .map_err(|e| JsError::new(&format!("{e:#}")))
